# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). Never commit .env.

# Used by the browser app. Only the project URL and the publishable (anon) key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/ and tests/ on your own machine. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password given to the fictional example.test demo accounts by the seed script.
# Local demo use only; do not reuse it anywhere real.
DEMO_ACCOUNT_PASSWORD=choose-a-local-demo-password
